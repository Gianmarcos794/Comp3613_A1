  "item": [
    {
      "name": "1. Setup (login & accounts)",
      "item": [
        {
          "name": "Admin login",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Unique suffix so the collection can run again without 'already taken' errors",
                  "pm.collectionVariables.set('run_id', String(Date.now()).slice(-7));",
                  "const day = 24 * 60 * 60 * 1000;",
                  "pm.collectionVariables.set('future_date', new Date(Date.now() + 30 * day).toISOString().slice(0, 10));",
                  "pm.collectionVariables.set('past_date', new Date(Date.now() - day).toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test(\"Returns an access token\", () => pm.expect(data.access_token).to.be.a(\"string\"));",
                  "pm.test(\"Role is admin\", () => pm.expect(data.role).to.eql(\"admin\"));",
                  "pm.collectionVariables.set('admin_token', data.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{admin_username}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "login"
              ]
            }
          },
          "response": []
        },
