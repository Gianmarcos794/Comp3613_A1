    {
      "name": "5. Match Application (Admin)",
      "item": [
        {
          "name": "View application with eligible internships",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const ids = pm.response.json().eligible_internships.map(i => i.id);",
                  "pm.test(\"New internship is eligible\", () => pm.expect(ids).to.include(pm.collectionVariables.get(\"internship_id\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/applications/{{application_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "applications",
                "{{application_id}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Match application to internship",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();",
                  "pm.test(\"Match links the application\", () => pm.expect(data.match.application_id).to.eql(pm.collectionVariables.get(\"application_id\")));",
                  "pm.test(\"Last position filled, internship closed\", () => pm.expect(data.internship.status).to.eql(\"closed\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
